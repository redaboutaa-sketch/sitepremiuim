# ==========================================================================
# À copier en `.env` À CÔTÉ du docker-compose.yml, puis à renseigner.
#
# Ces trois valeurs appartiennent à L'INSTALLATION TRAEFIK de la machine,
# pas à ce projet. Elles se relèvent sur une pile qui fonctionne déjà —
# les inventer donnerait un routeur que Traefik ignorerait en silence, ou un
# certificat jamais demandé.
#
# Pour les lire, prendre une application déjà servie par ce Traefik :
#
#     docker inspect tfn-prod-web \
#       --format '{{range $k,$v := .Config.Labels}}{{$k}}={{$v}}{{"\n"}}{{end}}' \
#       | grep traefik
#
#     docker inspect traefik \
#       --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
# ==========================================================================

# Le réseau Docker sur lequel Traefik découvre les conteneurs.
# Souvent « traefik », « proxy » ou « web ».
TRAEFIK_NETWORK=

# Le point d'entrée HTTPS, tel que Traefik le nomme dans SA configuration.
# Souvent « websecure », parfois « https ». Ce n'est PAS un numéro de port.
TRAEFIK_ENTRYPOINT_HTTPS=

# Le résolveur de certificats Let's Encrypt déclaré dans Traefik.
# Souvent « le », « letsencrypt » ou « myresolver ».
TRAEFIK_CERTRESOLVER=

# Le point d'entrée en clair (port 80), tel que Traefik le nomme.
# Presque toujours « web ».
TRAEFIK_ENTRYPOINT_HTTP=web
