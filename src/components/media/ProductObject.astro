---
/**
 * OBJET PRODUIT
 *
 * Deux rendus possibles, un seul contrat visuel :
 *   · asset publiable  → packshot détouré, posé, ancré par un filet de sol ;
 *   · sinon            → repli typographique composé.
 *
 * Le ratio est fixe dans les deux cas : aucun décalage de mise en page selon
 * qu'un fichier existe ou non. Le repli n'est PAS un rectangle gris — il est
 * dessiné pour être présentable, parce qu'il sera visible en production tant
 * que les assets ne sont pas fournis et validés.
 *
 * ⚠️ Aucune image générée ou substituée n'est jamais présentée comme un vrai
 * produit : en l'absence d'asset validé, on montre du texte, pas une image
 * inventée.
 */
import { Image } from 'astro:assets';

import type { Brand } from '@/lib/catalog';
import { categoryBySlug } from '@/lib/catalog';
import { resolve, type AssetMode, type AssetUsage } from '@/lib/assets';
import { opticalSize } from '@/lib/optical';

interface Props {
  brand: Brand;
  usage?: Extract<AssetUsage, 'packshot' | 'hero'>;
  /** Numéro d'index du catalogue. Affiché tel quel, non calculé. */
  index?: string;
  mode?: AssetMode;
  /** Largeurs candidates pour le rendu responsive. */
  widths?: number[];
  loading?: 'lazy' | 'eager';
  /**
   * `labelled` — le repli porte le nom de la marque : l'objet s'identifie
   *   lui-même, utile quand rien ne l'entoure (scène du hero).
   * `plain` — le repli reste muet : le nom vit à l'extérieur, dans le même
   *   emplacement qu'un packshot réel occuperait. C'est ce qui garantit une
   *   seule grammaire visuelle, que l'asset existe ou non — sans quoi le nom
   *   apparaît deux fois tant qu'il manque, puis une seule fois ensuite.
   */
  variant?: 'labelled' | 'plain';
  /**
   * Autorise le repli sur le LOGO de marque quand aucun packshot n'est
   * disponible.
   *
   * Réservé au catalogue `/drinks/`, sur surface claire. Sur encre, 23 des 60
   * logos livrés tombent sous le seuil de lisibilité — un logo sombre sur
   * fond quasi noir n'est pas un visuel, c'est une tache. Le hero, Featured
   * et S4 n'activent donc jamais cette option (décision DA du 2026-08-16).
   */
  allowLogo?: boolean;
}

const {
  brand,
  usage = 'packshot',
  index,
  mode,
  widths = [200, 400, 800],
  loading = 'lazy',
  variant = 'labelled',
  allowLogo = false,
} = Astro.props;

/*
 * Le packshot prime toujours. Le logo n'est qu'un second choix, et seulement
 * là où il a été explicitement autorisé : c'est un visuel de MARQUE, pas une
 * photographie de produit, et il ne doit jamais se faire passer pour telle.
 */
const packshot = resolve(brand.slug, usage, mode);
const logo = !packshot && allowLogo ? resolve(brand.slug, 'logo', mode) : null;
const asset = packshot ?? logo;
const isLogo = asset !== null && asset === logo;
const optical = isLogo ? opticalSize(asset) : null;

/*
 * Le texte alternatif dit ce que l'image EST. Un logo n'est pas un packshot,
 * et l'annoncer comme tel tromperait un lecteur d'écran sur la nature de ce
 * qu'il décrit.
 */
const altText = isLogo ? `${brand.brand} — logo` : `${brand.brand} — packshot`;

/**
 * Les fichiers vivent sous src/assets pour bénéficier de l'optimisation
 * (AVIF/WebP, tailles responsives, dimensions déclarées → CLS 0).
 * Le glob est statique : Astro ne peut pas résoudre un import dynamique.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/brands/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const file = asset?.path ? files[`/${asset.path}`]?.default : undefined;

const category = categoryBySlug(brand.category);
const familyLabel = category?.name.en ?? '';
---

<figure class="product-object" data-family={brand.category}>
  {
    file ? (
      <Image
        class:list={['product-object__img', isLogo && 'product-object__img--logo']}
        src={file}
        widths={widths}
        sizes="(min-width: 1024px) 25vw, 45vw"
        alt={altText}
        loading={loading}
        decoding="async"
        style={optical
          ? `--logo-w:${optical.width}%;--logo-h:${optical.height}%`
          : undefined}
      />
    ) : (
      <div class="product-object__fallback">
        {index ? <p class="t-index">{index}</p> : <span aria-hidden="true" />}
        {
          variant === 'labelled' ? (
            <div>
              <p class="product-object__fallback-name">{brand.brand}</p>
              {familyLabel && (
                <p class="t-label" style="margin-block-start: var(--sp-2)">{familyLabel}</p>
              )}
            </div>
          ) : (
            <span aria-hidden="true" />
          )
        }
      </div>
    )
  }
</figure>
