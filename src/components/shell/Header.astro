---
/**
 * HEADER
 *
 * Comportement collant — justifié par la direction artistique ET par US-008.
 *
 *   · Au repos il est TRANSPARENT : le hero est une scène cinématique, un
 *     bandeau opaque en couperait le cadrage dès la première seconde.
 *   · Après ~80 px de défilement il devient dense (fond ink + filet bas) :
 *     à ce stade le hero est derrière nous, et l'acheteur qui parcourt un
 *     catalogue de 62 marques doit pouvoir demander une offre sans remonter.
 *
 * Sans JavaScript, il reste dense en permanence — lisible dans tous les cas.
 */
import LangSwitch from './LangSwitch.astro';
import SiteMark from './SiteMark.astro';
import { useI18n, type Locale, type PageKey } from '@/i18n';

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
const i18n = useI18n(locale);
const t = i18n.t;

const NAV: Array<{ key: PageKey; label: string }> = [
  { key: 'drinks', label: t.nav.drinks },
  { key: 'brands', label: t.nav.brands },
  { key: 'about', label: t.nav.about },
  { key: 'contact', label: t.nav.contact },
];
---

<header class="header" data-header>
  <div class="header__inner container">
    <a class="header__mark" href={i18n.path('home')} aria-label={t.meta.siteName}>
      <SiteMark variant="wordmark" />
    </a>

    <nav class="header__nav" aria-label={t.nav.primary}>
      <ul class="header__list" role="list">
        {
          NAV.map((item) => (
            <li>
              <a
                class="link-nav"
                href={i18n.path(item.key)}
                aria-current={page === item.key ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__actions">
      <LangSwitch page={page} locale={locale} />
      <a class="btn btn--primary header__cta" href={i18n.path('contact')}>{t.cta.primary}</a>

      <button
        class="header__toggle"
        type="button"
        data-menu-toggle
        data-label-open={t.nav.openMenu}
        data-label-close={t.nav.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="visually-hidden" data-menu-label>{t.nav.openMenu}</span>
        <span class="header__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--z-header);
    /* Sans JS, l'état dense s'applique d'emblée : jamais de texte clair
       sur un fond indéterminé. */
    background: var(--ink-900);
    border-block-end: var(--hairline) solid var(--rule);
    transition:
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  /* Avec JS, le header s'efface au-dessus du hero puis se densifie. */
  :global(html[data-js]) .header {
    background: transparent;
    border-block-end-color: transparent;
  }

  :global(html[data-js]) .header[data-scrolled] {
    background: var(--ink-900);
    border-block-end-color: var(--rule);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    /* 72px mobile → 88px desktop. Assez haut pour respirer, assez bas pour
       ne pas amputer le hero. */
    min-block-size: 72px;
  }

  .header__mark {
    margin-inline-end: auto;
    display: inline-flex;
    align-items: center;
    /* Cible tactile de 44px sans agrandir visuellement la marque. */
    min-block-size: 44px;
    padding-block: var(--sp-3);
  }

  .header__nav {
    display: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .header__cta {
    display: none;
  }

  /* ── Bouton de menu — tactile et clavier, jamais dépendant du survol ── */
  .header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    margin-inline-end: calc(var(--sp-3) * -1);
    color: var(--fg);
  }

  .header__bars {
    display: block;
    inline-size: 22px;
  }

  .header__bars i {
    display: block;
    block-size: var(--hairline);
    background: currentColor;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .header__bars i + i {
    margin-block-start: 6px;
  }

  /* Croix — transformation du glyphe lui-même, pas une icône substituée. */
  [aria-expanded='true'] .header__bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  [aria-expanded='true'] .header__bars i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (min-width: 1024px) {
    .header__inner {
      min-block-size: 88px;
      gap: var(--sp-8);
    }

    .header__nav,
    .header__cta {
      display: block;
    }

    .header__toggle {
      display: none;
    }
  }
</style>
