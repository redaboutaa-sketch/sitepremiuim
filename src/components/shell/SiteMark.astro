---
/**
 * MARQUE DU SITE — identité officielle Ivan Arsenov.
 *
 * Deux tracés distincts sont fournis par le client : un sombre pour les
 * surfaces claires, un clair pour l'encre. Ce ne sont pas deux rendus d'un
 * même fichier, mais deux dessins ; le composant choisit, il n'inverse rien.
 *
 * Le repli typographique demeure pour le cas où un asset manquerait. Il porte
 * `data-mark-provisional`, ce qui permet à la QA de détecter une mise en
 * production avec une identité provisoire — et il n'est JAMAIS présenté comme
 * l'asset officiel.
 */
import { Image } from 'astro:assets';

import { COMPANY } from '@/data/company';
import { IDENTITY_TONES } from '@/data/assets';
import { resolve, type AssetMode, type AssetUsage } from '@/lib/assets';

interface Props {
  variant?: Extract<AssetUsage, 'wordmark' | 'lockup' | 'monogram'>;
  mode?: AssetMode;
  /** Hauteur de rendu, en pixels. */
  height?: number;
  /**
   * Surface d'accueil. Détermine LEQUEL des deux tracés est servi — jamais un
   * filtre CSS : teinter un logo est une altération de l'identité.
   */
  tone?: 'light' | 'dark';
  /**
   * Densités servies. `[1, 2]` par défaut — la marque doit rester nette là où
   * on la lit.
   *
   * Un usage la lit pourtant à peine : le filigrane du Hero, à 3,5 %
   * d'opacité. Son amplitude maximale y est de 8/255 ; servir une variante
   * deux fois plus définie n'y change RIEN de perceptible (mesure : écart
   * maximal 3/255 entre une source de 320 px et la source native de 600 px)
   * et coûte 23 Ko sur la page d'accueil. La densité est donc réglable.
   */
  densities?: number[];
  class?: string;
}

const {
  variant = 'lockup',
  mode,
  height = 20,
  tone = 'light',
  densities = [1, 2],
  class: className,
} = Astro.props;

const asset = resolve('ivan-arsenov', variant, mode);

/*
 * Le glob est statique et eager : Astro ne résout pas d'import dynamique.
 * On n'y met que `src/assets/identity/`, jamais les marques du catalogue.
 */
const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/identity/*.{webp,png,avif}',
  { eager: true },
);

const path = asset ? IDENTITY_TONES[variant]?.[tone] : undefined;
const file = path ? files[`/${path}`]?.default : undefined;
---

{
  file ? (
    <Image
      class:list={['site-mark__img', className]}
      src={file}
      height={height}
      width={Math.round((file.width / file.height) * height)}
      densities={densities}
      alt=""
      loading="eager"
      decoding="async"
    />
  ) : (
    <span
      class:list={['site-mark', 'site-mark--type', className]}
      data-mark-provisional="identité provisoire — asset officiel non résolu"
    >
      {COMPANY.name}
    </span>
  )
}

<style>
  /*
   * `height` et `width` sont posés en attributs par <Image> : le navigateur
   * réserve la place avant le décodage, donc aucun décalage de mise en page.
   * La règle ci-dessous ne fait que rendre la hauteur souveraine.
   */
  .site-mark__img {
    display: block;
    inline-size: auto;
    object-fit: contain;
  }

  .site-mark {
    display: inline-flex;
    align-items: center;
    color: var(--fg);
  }

  /*
   * Repli typographique — Instrument Serif en capitales espacées, à l'image
   * du wordmark réel, mais assumé comme du texte : aucune tentative de
   * reproduire la liaison du monogramme.
   */
  .site-mark--type {
    font-family: var(--font-display);
    font-size: 1.125rem;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* Compense le letterspacing final pour que l'optique reste alignée. */
    margin-inline-end: -0.22em;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .site-mark--type {
      font-size: 1.25rem;
    }
  }
</style>
