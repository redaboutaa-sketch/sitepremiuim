---
/**
 * Squelette HTML commun à toutes les pages.
 *
 * TR-001 : structure sémantique et <head> uniquement.
 * Le header, la navigation et le footer arrivent en TR-005 ;
 * les styles en TR-002.
 */
import BaseHead from '@/components/seo/BaseHead.astro';
import { useI18n, type Locale, type PageKey } from '@/i18n';
import '@/styles/index.css';

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
const i18n = useI18n(locale);
---

<!doctype html>
<html lang={i18n.htmlLang}>
  <head>
    <BaseHead page={page} locale={locale} />

    {/* Précharge du chemin critique uniquement — les sous-jeux latin-ext
        se chargent à la demande via leur unicode-range. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/instrument-serif-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Marque la disponibilité de JS avant le premier rendu : sans lui, les
        éléments à révéler restent visibles (voir motion.css). */}
    <script is:inline>
      document.documentElement.setAttribute('data-js', '');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{i18n.t.nav.skipToContent}</a>

    <!-- TR-005 : <header> -->

    <main id="main">
      <slot />
    </main>

    <!-- TR-005 : <footer> -->
  </body>
</html>
