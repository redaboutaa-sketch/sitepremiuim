---
/**
 * HOMEPAGE.
 *
 * Six sections, dont le rythme d'impact est délibérément inégal :
 * un site où chaque section cherche le « wow » devient épuisant.
 * S1 hero · S2 featured · S3 éditorial calme · S4 second grand moment ·
 * S5 process sobre · S6 CTA final.
 */
import Categories from '@/components/home/Categories.astro';
import Discovery from '@/components/home/Discovery.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import FeaturedBrands from '@/components/home/FeaturedBrands.astro';
import Process from '@/components/home/Process.astro';
import Hero from '@/components/home/Hero.astro';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Hero locale={locale} />
<FeaturedBrands locale={locale} />
<Categories locale={locale} />
<Discovery locale={locale} />
<Process locale={locale} />
<FinalCta locale={locale} />

<script>
  import '@/scripts/hero.ts';
  import { initTrack } from '@/scripts/track.ts';
  import { initDrift } from '@/scripts/drift.ts';
  initTrack();
  initDrift();
</script>
