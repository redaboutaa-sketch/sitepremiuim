---
/**
 * PAGES LÉGALES — Impressum, Privacy, Cookies.
 *
 * ⚠️ TEXTES RÉDIGÉS LE 2026-08-29 — RELECTURE JURIDIQUE RECOMMANDÉE.
 *
 * Ce ne sont plus des placeholders : les textes sont rédigés, en EN et en DE,
 * et décrivent ce que ce site fait RÉELLEMENT — pas de cookies, aucun script
 * tiers, aucune requête externe, polices auto-hébergées, un seul traitement
 * (le formulaire). Chaque affirmation a été vérifiée contre le code.
 *
 * Ce qu'ils NE sont pas : un avis juridique. Ils ont été rédigés par
 * l'intégrateur, pas par un avocat. Deux points méritent particulièrement
 * l'œil du conseil d'Ivan Arsenov, et sont documentés dans doc/go-live.md :
 *   · l'absence de numéro de téléphone au titre du § 5 DDG ;
 *   · la qualification du sessionStorage au titre du § 25 Abs. 2 Nr. 2 TDDDG,
 *     qui justifie l'absence de bandeau de consentement.
 *
 * Le Steuernummer n'est PAS publié : le § 5 DDG n'exige que l'USt-IdNr.
 *
 * Aucun document du benchmark n'est copié.
 * La page Cookies DÉCRIT l'usage technique et NE CONCLUT PAS sur le régime
 * de consentement applicable — cette qualification relève de D9.
 */
import { COMPANY, addressLines } from '@/data/company';
import { useI18n, type Locale, type PageKey } from '@/i18n';

interface Props {
  page: Extract<PageKey, 'imprint' | 'privacy' | 'cookies'>;
  locale: Locale;
}

const { page, locale } = Astro.props;
const i18n = useI18n(locale);
const t = i18n.t;
const doc = t.legal[page];

/** Une page légale non-Impressum est composée de sections titrées. */
interface Section {
  heading: string;
  body: string[];
}
const sections: Section[] = doc.sections;
---

<section class="legal section" data-surface="ink">
  <div class="container">
    <p class="t-label t-label--ruled">{t.legal.eyebrow}</p>
    <h1 class="t-h1 legal__title">{doc.title}</h1>

    <p class="legal__updated t-small t-muted">{t.legal.updated}</p>

    {
      page === 'imprint' && (
        <div class="legal__body">
          <h2 class="t-h3">{t.legal.imprint.providerHeading}</h2>
          <address class="legal__address t-body">
            <strong>{COMPANY.legalName}</strong>
            {addressLines().map((line) => <span>{line}</span>)}
          </address>

          <h2 class="t-h3">{t.legal.imprint.contactHeading}</h2>
          <p class="t-body">
            <a class="link-inline" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
          </p>
          {t.legal.imprint.contactBody.map((paragraph) => (
            <p class="t-body t-secondary">{paragraph}</p>
          ))}

          {/*
            SEULE l'USt-IdNr est publiée. Le § 5 DDG l'exige (n° 6) ; il
            n'exige NULLE PART le Steuernummer, et le publier facilite
            l'usurpation d'identité fiscale sans rien apporter au visiteur.
            `COMPANY.taxNumber` reste dans les données — la donnée est vraie et
            sert ailleurs — mais elle ne sort pas sur cette page.
          */}
          <h2 class="t-h3">{t.legal.imprint.taxHeading}</h2>
          <p class="t-body t-secondary">{t.legal.imprint.taxBody}</p>
          <p class="t-body legal__mono">{COMPANY.vatId}</p>

          <h2 class="t-h3">{t.legal.imprint.responsibleHeading}</h2>
          <p class="t-body t-secondary">{t.legal.imprint.responsibleBody}</p>
          <p class="t-body">{COMPANY.legalName}, {addressLines().join(', ')}</p>

          {sections.map((section) => (
            <>
              <h2 class="t-h3">{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p class="t-body t-secondary">{paragraph}</p>
              ))}
            </>
          ))}
        </div>
      )
    }

    {
      page !== 'imprint' && (
        <div class="legal__body">
          {sections.map((section) => (
            <>
              <h2 class="t-h3">{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p class="t-body t-secondary">{paragraph}</p>
              ))}
            </>
          ))}

          <h2 class="t-h3">{t.legal.controllerHeading}</h2>
          <address class="legal__address t-body">
            <strong>{COMPANY.legalName}</strong>
            {addressLines().map((line) => <span>{line}</span>)}
            <a class="link-inline" href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
          </address>
        </div>
      )
    }
  </div>
</section>

<style>
  .legal__title {
    margin-block: var(--sp-5) var(--sp-6);
    max-inline-size: 18ch;
  }

  /*
   * Le bandeau « brouillon en attente de relecture » a été retiré le
   * 2026-08-29 avec la rédaction des textes définitifs. Il s'adressait au
   * client mais s'affichait au PUBLIC : une page légale qui annonce
   * elle-même n'être qu'un gabarit est pire que pas de page du tout.
   *
   * Ce qui doit rester visible, c'est la DATE : une mention légale sans date
   * ne permet pas de savoir à quelle version on a affaire.
   */
  .legal__updated {
    margin-block-end: var(--sp-8);
  }

  .legal__body {
    display: grid;
    gap: var(--sp-4);
    max-inline-size: 68ch;
  }

  .legal__body :global(h2) {
    margin-block-start: var(--sp-6);
    color: var(--fg);
  }

  .legal__address {
    display: grid;
    gap: var(--sp-1);
    font-style: normal;
    color: var(--fg-secondary);
  }

  .legal__facts {
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 640px) {
    .legal__facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .legal__mono {
    font-variant-numeric: tabular-nums;
    color: var(--fg-secondary);
    user-select: all;
  }
</style>
