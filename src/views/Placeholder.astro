---
/**
 * Vue provisoire TR-001.
 *
 * Sert uniquement à prouver que les 16 routes résolvent et que l'i18n est
 * câblée. Remplacée page par page par les vues réelles à partir de TR-006.
 * Aucun contenu de cette vue ne doit survivre à TR-016.
 */
import { useI18n, type Locale, type PageKey } from '@/i18n';

interface Props {
  page: PageKey;
  locale: Locale;
}

const { page, locale } = Astro.props;
const i18n = useI18n(locale);
const meta = i18n.t.pages[page];
---

<section class="section placeholder" data-surface="ink">
  <div class="container">
    <p class="t-label t-label--ruled">{page}</p>
    <h1 class="t-h1" style="margin-block: var(--sp-5) var(--sp-5)">{meta.title}</h1>
    <p class="t-body-l t-secondary">{meta.description}</p>
    <p class="t-index" style="margin-block-start: var(--sp-8)" data-tr-001-marker={`${page}:${locale}`}>
      Contenu de section à venir — TR-006 et suivants.
    </p>
  </div>
</section>

<style>
  /* Hauteur de travail : le shell doit pouvoir être jugé et testé en
     conditions de défilement avant que les vraies sections existent. */
  .placeholder {
    min-block-size: 130vh;
  }
</style>
